# The serve and demo commands create .env with a random token automatically.
IMAGE_RELEVANCE_API_KEYS={"demo":"replace-with-a-long-random-token"}
IMAGE_RELEVANCE_DATA_DIR=data
IMAGE_RELEVANCE_DEVICE=cpu
IMAGE_RELEVANCE_VISION_MODEL=yolo26s-cls.pt
IMAGE_RELEVANCE_CAPTION_MODEL=Salesforce/blip-image-captioning-base
IMAGE_RELEVANCE_MIN_CONFIDENCE=0.55
IMAGE_RELEVANCE_DAILY_CALL_LIMIT=500
